# Frontend specific ignores

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production builds
.next/
out/
build/
dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.qa

# Vercel
.vercel

# Turborepo
.turbo

# Storybook build outputs
.out
.storybook-out

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# ESLint cache
.eslintcache

# Stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local configuration files
config/local.json
.local/
config/local.js
config/local.ts

# Test files
test-results/
playwright-report/
test-results.xml

# Sentry
.sentryclirc

# TypeScript
*.tsbuildinfo

# Prettier
.prettierignore

# Husky
.husky/_/

# lint-staged
.lintstagedrc

# Commitizen
.czrc

# Local development
.local/
dev/

# CSS compilation
.sass-cache/

# Bundle analyzer
bundle-analyzer-report.html

# Image optimization cache
.next/cache/

# API keys and client-side secrets (if any)
secrets/
credentials/
private/
config/secrets.json

# Analytics and tracking (client-side)
google-analytics.json
segment-keys.json
gtag-keys.json

# Social media integration (client-side)
facebook-sdk.json
twitter-sdk.json
linkedin-sdk.json

# Payment processor (client-side)
stripe-public.json
paypal-client.json

# Email service (client-side)
sendgrid-public.json

# Third-party service client configs
third-party-client.json
services-client.json

# User uploaded content (if stored locally)
public/uploads/
static/uploads/
user-content/

# Cache and temporary assets
.cache/
.temp/
.tmp/

# Build artifacts and bundles
*.bundle.js
*.bundle.css
*.min.js
*.min.css

# Source maps (if not needed in production)
*.map

# Environment-specific builds
build-production/
build-staging/
build-development/
