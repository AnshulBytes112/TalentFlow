# Production env (do NOT commit real secrets). Set these as secrets on your host (Render/Vercel).
PORT=5000
NODE_ENV=production
MONGODB_URI=<YOUR_PROD_MONGODB_URI>

# JWT (use strong secrets)
JWT_ACCESS_SECRET=<PROD_JWT_ACCESS_SECRET>
JWT_REFRESH_SECRET=<PROD_JWT_REFRESH_SECRET>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

FRONTEND_URL=https://your-frontend-domain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# Use Gmail API in production (recommended on Render)
EMAIL_PROVIDER=gmail_api
GMAIL_CLIENT_ID=<GMAIL_CLIENT_ID>
GMAIL_CLIENT_SECRET=<GMAIL_CLIENT_SECRET>
GMAIL_REFRESH_TOKEN=<GMAIL_REFRESH_TOKEN>
GMAIL_SENDER_EMAIL=<GMAIL_SENDER_EMAIL>

API_URL=https://your-backend-domain.com
BACKEND_URL=https://your-backend-domain.com

ENABLE_CRON_JOBS=true
ENABLE_ANALYTICS=true
REDIS_URL=<REDIS_URL>
CACHE_TTL=3600
