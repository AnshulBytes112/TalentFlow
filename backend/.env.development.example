# Development env (local). Copy to `backend/.env` and fill values.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/job-portal

# JWT
JWT_ACCESS_SECRET=dev_jwt_access_secret_replace
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_replace
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (used in emails/links)
FRONTEND_URL=http://localhost:3000

# Cloudinary (optional for local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email provider: smtp | gmail_api
EMAIL_PROVIDER=gmail_api

# SMTP (optional local fallback)
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_SECURE=false
#EMAIL_USER=your-email@gmail.com
#EMAIL_PASS=your-app-password

# Gmail API (recommended when SMTP ports are blocked)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# API/Backend addresses
API_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# Optional toggles
ENABLE_CRON_JOBS=false
ENABLE_ANALYTICS=false
